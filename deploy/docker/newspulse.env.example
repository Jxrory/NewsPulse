# Copy to deploy/docker/newspulse.env and chmod 600.
# Replace every value before deployment; never commit the filled file.
NEWSPULSE_ADMIN_TOKEN=replace-with-a-long-random-token

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Required only after notification.enabled=true in config.yaml.
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=
